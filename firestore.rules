rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leitura e escrita apenas nas coleções oficiais do sistema Impacto Aviation
    // Sem data de expiração (regras permanentes de produção com escopo restrito)

    match /base/{id} {
      allow read, write: if true;
    }

    match /pessoa/{id} {
      allow read, write: if true;
    }

    match /licenca/{id} {
      allow read, write: if true;
    }

    match /curso_catalogo/{id} {
      allow read, write: if true;
    }

    match /treinamento/{id} {
      allow read, write: if true;
    }

    match /motor_catalogo/{id} {
      allow read, write: if true;
    }

    match /treinamento_motor/{id} {
      allow read, write: if true;
    }

    match /designacao_pessoa/{id} {
      allow read, write: if true;
    }

    match /designacao_base/{id} {
      allow read, write: if true;
    }

    match /designacao_funcao/{id} {
      allow read, write: if true;
    }

    match /designacao_aeronave/{id} {
      allow read, write: if true;
    }

    match /configuracao/{id} {
      allow read, write: if true;
    }

    match /auditoria/{id} {
      allow read, write: if true;
    }

    // Bloquear qualquer outra coleção ou caminho desconhecido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
